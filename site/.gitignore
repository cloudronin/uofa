# dependencies
node_modules/
package-lock.json.bak

# Synced from external sources by site/scripts/sync-readmes.mjs
# (kept out of git so docs/<file>.md is the single source of truth)
src/content/docs/readme.md
src/content/docs/docs/

# Generated by site/package.json prebuild from `uofa catalog`/`--help-all`
src/content/docs/reference/cli.md
src/content/docs/reference/catalog.md

# Generated by site/scripts/gen-iri-pages.mjs — one page per UofA node IRI.
# public/ also holds committed assets (CNAME, handout/, physmap/, the PDFs), so
# these must be listed per namespace rather than ignoring the directory.
# gen-iri-pages.mjs asserts every ALLOWED_SEGMENTS entry appears here.
public/morrison/
public/nagaraja/
public/iso42001/
public/surrogate/
public/instances/
public/org/
public/criteria/
src/content/docs/reference/identifiers.md

