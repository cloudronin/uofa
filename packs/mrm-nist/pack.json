{
  "$schema": "https://uofa.net/schemas/pack-manifest/v1.json",
  "name": "mrm-nist",
  "version": "0.2.0",
  "description": "Model credibility: NIST AI RMF model-card documentation completeness (Group A, 17 presence-only factors grouped by GOVERN/MAP/MEASURE/MANAGE) plus NIST AI 800-3 evaluation sufficiency (Group B, 6 factors assessing a reported benchmark result as validation evidence, the way vv40 assesses a simulation validation study). Presence-only throughout, no risk tiers and no 1-5 levels. The two groups are firewalled: each group's shapes are gated on a required factorStandard match, and every Group-B rule binds hasValidationResult, so neither group's weakeners can fire on the other's absent inputs.",
  "standards": [
    "NIST-AI-RMF-1.0",
    "NIST-AI-800-3",
    "ASME-VV40-2018"
  ],
  "author": "Vishnu Vettrivel",
  "license": "Apache-2.0",
  "coreCompatibility": ">=0.5.0",
  "prompt": "prompts/mrm_nist_extract_prompt.txt",
  "factors": 23,
