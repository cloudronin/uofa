{
  "$schema": "https://uofa.net/schemas/pack-manifest/v1.json",
  "name": "vv40",
  "version": "0.5.0",
  "description": "ASME V&V 40-2018 credibility factor taxonomy (13 factors).",
  "standards": [
    "ASME-VV40-2018",
    "FDA-2023-CMS"
  ],
  "author": "Vishnu Vettrivel",
  "license": "Apache-2.0",
  "coreCompatibility": ">=0.6.0",
  "template": "templates/vv40-template.xlsx",
  "prompt": "prompts/vv40_extract_prompt.txt",
  "factors": 13,
  "capabilities": [
    {
      "leg": "detection",
      "capabilityId": "detection:vv40-factors",
      "targetInterface": "detection",
      "interfaceVersion": "1.0",
      "firewallPlacement": "measurement-region",
      "provenance": {
        "stampsPackVersion": true
      },
      "payload": {
        "shapes": "shapes/vv40_shapes.ttl",
        "patternIds": [],
        "oos": {
          "enabled": false,
          "rule_files": [
            "rules/oos/oos_v0.1.rules"
          ]
        },
        "quantityIdentity": {
          "_note": "Quantity identity for corroboration: how a quantity named in prose and a quantity read out of a solver artifact are known to be the same one. Piece 1 of both layer specs. Units are converted ONLY through the factors declared here -- a unit absent from a quantity's table makes the pair not-comparable rather than coerced, because a silent conversion that is wrong produces an answer that validates (Requirement Layer spec v0.1, open question Q3). Tolerance is relative, applied to the canonical value.",
          "material.youngs_modulus": {
            "canonicalUnit": "MPa",
            "tolerance": 0.005,
            "units": {
              "Pa": 1e-06,
              "kPa": 0.001,
              "MPa": 1.0,
              "GPa": 1000.0
            }
          },
          "material.poissons_ratio": {
            "canonicalUnit": "",
            "tolerance": 0.005,
            "units": {
              "": 1.0
            }
          },
          "material.yield_strength": {
            "canonicalUnit": "MPa",
            "tolerance": 0.005,
            "units": {
              "Pa": 1e-06,
              "kPa": 0.001,
              "MPa": 1.0,
              "GPa": 1000.0
            }
          },
          "material.tangent_modulus": {
            "canonicalUnit": "MPa",
            "tolerance": 0.005,
            "units": {
              "Pa": 1e-06,
              "kPa": 0.001,
              "MPa": 1.0,
              "GPa": 1000.0
            }
          },
          "material.density": {
            "canonicalUnit": "kg m^-3",
            "tolerance": 0.005,
            "units": {
              "kg m^-3": 1.0,
              "g cm^-3": 1000.0
            }
          },
          "project.ansys_release": {
            "canonicalUnit": "",
            "comparison": "string"
          }
        }
      }
    }
  ]
}
