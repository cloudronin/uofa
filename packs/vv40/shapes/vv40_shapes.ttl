@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix uofa: <https://uofa.net/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# V&V 40 Table 5-1 factor taxonomy
# Only applies to factors tagged with factorStandard "ASME-VV40-2018"
# (or factors without factorStandard, for backward compat with single-pack use)
uofa:VV40CredibilityFactorShape a sh:NodeShape ;
    sh:targetClass uofa:CredibilityFactor ;
    sh:sparql [
        sh:message "factorType must be one of the 13 V&V 40 Table 5-1 factor names." ;
        sh:select """
            SELECT $this
            WHERE {
                $this uofa:factorType ?ft .
                OPTIONAL { $this uofa:factorStandard ?fs }
                FILTER (
                    (!BOUND(?fs) || ?fs = "ASME-VV40-2018")
                    && ?ft NOT IN (
                        "Software quality assurance",
                        "Numerical code verification",
                        "Discretization error",
                        "Numerical solver error",
                        "Use error",
                        "Model form",
                        "Model inputs",
                        "Test samples",
                        "Test conditions",
                        "Equivalency of input parameters",
                        "Output comparison",
                        "Relevance of the quantities of interest",
                        "Relevance of the validation activities to the COU"
                    )
                )
            }
        """ ;
    ] .

# V&V 40 level range: 1-5 (only for ASME-VV40-2018 factors)
uofa:VV40LevelRangeShape a sh:NodeShape ;
    sh:targetClass uofa:CredibilityFactor ;
    sh:sparql [
        sh:message "V&V 40 factors must have requiredLevel in range 1-5." ;
        sh:select """
            SELECT $this
            WHERE {
                $this uofa:requiredLevel ?rl .
                OPTIONAL { $this uofa:factorStandard ?fs }
                FILTER (
                    (!BOUND(?fs) || ?fs = "ASME-VV40-2018")
                    && (?rl < 1 || ?rl > 5)
                )
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "V&V 40 factors must have achievedLevel in range 1-5." ;
        sh:select """
            SELECT $this
            WHERE {
                $this uofa:achievedLevel ?al .
                OPTIONAL { $this uofa:factorStandard ?fs }
                FILTER (
                    (!BOUND(?fs) || ?fs = "ASME-VV40-2018")
                    && (?al < 1 || ?al > 5)
                )
            }
        """ ;
    ] .


# deviceClass: the FDA classification, constrained here rather than in core.
#
# ASME V&V 40 is "Assessing Credibility of Computational Modeling through
# Verification and Validation: Application to Medical Devices", so the FDA risk
# class is meaningful under this pack and meaningless under nasa-7009b. Core
# used to impose the enum on every package, which produced the inverse of a
# constraint: aerospace packages that invented "Class II" for a turbomachinery
# model passed, and packages that honestly wrote "Turbomachinery (Centrifugal
# Pump)" failed.
#
# "N/A" is allowed, and is the point. Both extract prompts already offer it, and
# a V&V 40 assessment of something that is not a regulated device needs a way to
# say so without either fabricating a class or failing validation.
#
# Attached to the core body shape by RDF merge rather than declared as a
# separate NodeShape. That is load-bearing: shacl_friendly.py drills into the
# body shape the document declares and walks its sh:property list by hand to
# build the field-level report. A standalone shape still fires, but reports
# without the requirement/actual/fix detail -- which is exactly the opaque
# rollup the drill-in exists to replace.
uofa:UnitOfAssurance_CompleteBody
    sh:property [
        sh:path uofa:deviceClass ;
        sh:maxCount 1 ;
        sh:in ( "Class I" "Class II" "Class III" "N/A" ) ;
        sh:message "deviceClass must be Class I, Class II, Class III (FDA classification), or N/A when the context of use is not a regulated device." ;
    ] .

################################################################
# Context of use — moved out of core in v0.8.
#
# Required of every V&V 40 UnitOfAssurance, which is what core required
# of EVERY UnitOfAssurance until v0.8. Behaviour for a V&V 40 package is
# unchanged: vv40 is the default active pack, so this shape loads on a
# default invocation exactly as the core constraint did.
#
# What changes is NASA-STD-7009A. That standard has no context of use,
# and a 7009A package validated with `--pack nasa-7009b` no longer loads
# this file -- so it is no longer asked for a field its standard does not
# define, and no longer has to invent one to validate.
################################################################
uofa:VV40ContextOfUseShape a sh:NodeShape ;
    sh:targetClass uofa:UnitOfAssurance ;
    sh:property [
        sh:path uofa:hasContextOfUse ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "V&V 40: must declare a Context of Use (COU) — the specific question the model is being used to inform." ;
    ] .
