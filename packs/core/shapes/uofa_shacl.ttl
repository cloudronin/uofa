@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix uofa: <https://uofa.net/vocab#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

################################################################
# §A — embedded vocabulary (RDFS)
#
# Mirrors the iso42001, surrogate and disposition packs: no separate
# vocab.ttl, no external ontology file. The existing pyshacl loader reads
# this file already, and site/scripts/lib/vocab-extract.mjs harvests these
# declarations to render https://uofa.net/vocab#.
#
# These triples are inert to validation. shacl_friendly.py calls pyshacl
# with no ont_graph and no inference, so nothing here can affect sh:class
# or sh:targetClass resolution. It is documentation that happens to live
# next to the shapes it documents.
#
# Three rules, all from docs/vocabulary-authoring-spec.md:
#
#   1. Core is standard-agnostic. No definition here cites ASME V&V 40,
#      NASA-STD-7009B or ISO 42001. uofa:factorType and uofa:factorStandard
#      are each constrained by four different packs, so naming one standard
#      makes the definition false for the others. uofa:factorStandard exists
#      precisely because the governing standard is data on the factor.
#   2. Labels follow the corpus: classes Title Case, properties lowercase.
#   3. rdfs:domain is declared only where ONE class is true of every carrier.
#      It entails "anything carrying this IS an X", not "may only appear on
#      an X", so a property used on two classes gets no domain and names them
#      in its comment instead. Same for any domain or range that would point
#      at uofa-aims: or uofa-surr:, which would make core depend on a pack.
#      25 of the 90 properties are omitted on one of those two grounds.
#
# Do NOT declare uofa:Disposition or uofa:Discrepancy here. They are defined
# in packs/disposition/shapes/disposition_shapes.ttl, and the site harvester
# merges packs with Object.assign, so a duplicate would silently overwrite
# rather than conflict.
################################################################

# §A.1 — the structural spine.
#
# These nine classes name the model every other term hangs off. Sourced from
# site/src/content/docs/concepts/uofa.md, the concepts/weakeners page, the node
# shapes below, and the shipped example packages.

uofa:UnitOfAssurance a rdfs:Class ;
    rdfs:label "Unit of Assurance" ;
    rdfs:comment "The smallest independently verifiable package of credibility evidence. One package covers one context of use, and its signature lets a reviewer check the decision without access to the original tooling." .

uofa:ContextOfUse a rdfs:Class ;
    rdfs:label "Context of Use" ;
    rdfs:comment "The specific use a model is being trusted for, and the decision that rides on it. Credibility is assessed against this rather than against the model in general." .

uofa:CredibilityFactor a rdfs:Class ;
    rdfs:label "Credibility Factor" ;
    rdfs:comment "One dimension of credibility assessed for a context of use. Records the rigor required against the rigor achieved, and states plainly when a dimension was not assessed." .

uofa:ValidationResult a rdfs:Class ;
    rdfs:label "Validation Result" ;
    rdfs:comment "A recorded comparison between what the model predicted and what was measured, offered as evidence for the claim the package makes." .

uofa:AssuranceClaim a rdfs:Class ;
    rdfs:label "Assurance Claim" ;
    rdfs:comment "The proposition the evidence is offered in support of. Naming it separately is what lets a reviewer ask whether the evidence actually supports it." .

uofa:AcceptanceCriteria a rdfs:Class ;
    rdfs:label "Acceptance Criteria" ;
    rdfs:comment "The rubric an assessment is graded against, whether a published standard or one an organization devised for itself. Recorded so a reader knows what bar was applied. Distinct from the acceptanceCriteria property, which states one bar inline on a single factor or claim." .

uofa:DecisionRecord a rdfs:Class ;
    rdfs:label "Decision Record" ;
    rdfs:comment "The judgement reached on a context of use, naming who reached it and why. A package states its decision here rather than leaving it to be inferred from the evidence." .

uofa:OffsetRationale a rdfs:Class ;
    rdfs:label "Offset Rationale" ;
    rdfs:comment "A stated reason for accepting a credibility factor that fell short of its required level, pointing at the factor and at whatever compensates for the gap." .

uofa:WeakenerAnnotation a rdfs:Class ;
    rdfs:label "Weakener Annotation" ;
    rdfs:comment "A condition under which the stated evidence does not support the claim it is offered for. It describes the record as published, not a defect in the modeling work." .


# §A.2 — profiles and the remaining classes.

uofa:ProfileMinimal a rdfs:Class ;
    rdfs:label "Minimal Profile" ;
    rdfs:comment "The lighter of the two field sets, enough for an audit trail or a pipeline capture without a full credibility argument." .

uofa:ProfileComplete a rdfs:Class ;
    rdfs:label "Complete Profile" ;
    rdfs:comment "The fuller field set, adding model bindings and per-factor assessments to what the minimal profile requires." .

uofa:Comparator a rdfs:Class ;
    rdfs:label "Comparator" ;
    rdfs:comment "The measurement or reference a model prediction was checked against." .

uofa:VerificationActivity a rdfs:Class ;
    rdfs:label "Verification Activity" ;
    rdfs:comment "Work done to check the model was built and solved correctly, as distinct from checking it against measurement." .


# §A.3 — package structure and bindings.

uofa:conformsToProfile a rdf:Property ;
    rdfs:label "conforms to profile" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:comment "Which field set the package claims to meet, so validation knows what to require of it." .

uofa:bindsRequirement a rdf:Property ;
    rdfs:label "binds requirement" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:comment "Links the package to the requirement its model is being trusted to help satisfy." .

uofa:bindsClaim a rdf:Property ;
    rdfs:label "binds claim" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:range uofa:AssuranceClaim ;
    rdfs:comment "Links the package to the proposition its evidence is offered in support of." .

uofa:bindsModel a rdf:Property ;
    rdfs:label "binds model" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:comment "Links the package to the model whose credibility is being assessed." .

uofa:bindsDataset a rdf:Property ;
    rdfs:label "binds dataset" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:comment "Links the package to data the model was run against or compared with." .

uofa:hasContextOfUse a rdf:Property ;
    rdfs:label "has context of use" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:range uofa:ContextOfUse ;
    rdfs:comment "Links the package to the single context of use it covers." .

uofa:hasCredibilityFactor a rdf:Property ;
    rdfs:label "has credibility factor" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:range uofa:CredibilityFactor ;
    rdfs:comment "Links the package to one dimension of its credibility assessment." .

# No rdfs:range uofa:ValidationResult yet. Every typed target in the corpus is
# one except iso42001 hybrid/cou1, which points this at an AuditResultsRecord to
# satisfy the ProfileMinimal minCount while having no model evaluation to name.
# Declaring the range would entail that an AIMS audit is a validation result.
# tests/test_validation_result_taxonomy.py holds that as a listed exception and
# says what to do when it is resolved.
uofa:hasValidationResult a rdf:Property ;
    rdfs:label "has validation result" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:comment "Links the package to a comparison offered as evidence for its claim. The target should be a ValidationResult or a subclass of one; a pack that attaches its own class here is expected to declare that subclass relationship." .

uofa:hasDecisionRecord a rdf:Property ;
    rdfs:label "has decision record" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:range uofa:DecisionRecord ;
    rdfs:comment "Links the package to the judgement reached on it." .

uofa:hasWeakener a rdf:Property ;
    rdfs:label "has weakener" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:comment "Links a package to a condition under which its stated evidence does not support the claim it is offered for." .

uofa:hasEvidence a rdf:Property ;
    rdfs:label "has evidence" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:comment "Links a record to a supporting artifact held outside the package." .


# §A.4 — the context of use.

uofa:couName a rdf:Property ;
    rdfs:label "context of use name" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:range xsd:string ;
    rdfs:comment "A short readable name for the context of use, used where a full node would be unwieldy." .

uofa:intendedUse a rdf:Property ;
    rdfs:label "intended use" ;
    rdfs:comment "What the model is to be used for here, stated plainly enough to judge whether the evidence covers it. Carried by the context of use or by the package as a whole, so no single domain is declared." .

uofa:modelRiskLevel a rdf:Property ;
    rdfs:label "model risk level" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:range xsd:integer ;
    rdfs:comment "How much rides on the model being right, combining its influence over the decision with the consequence of that decision going wrong." .

uofa:deviceClass a rdf:Property ;
    rdfs:label "device class" ;
    rdfs:comment "The regulatory risk class of the device the model supports, where the governing regime defines such classes. Carried by the context of use or by the package as a whole, so no single domain is declared." .

uofa:hasOperatingEnvelope a rdf:Property ;
    rdfs:label "has operating envelope" ;
    rdfs:domain uofa:ContextOfUse ;
    rdfs:comment "Links a context of use to the input range the model is claimed to hold over. Without it the claim has no stated boundary." .

uofa:assuranceLevel a rdf:Property ;
    rdfs:label "assurance level" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:comment "How much confidence the package as a whole claims, on a coarse scale a reader can compare across records." .


# §A.5 — credibility factors.

uofa:factorType a rdf:Property ;
    rdfs:label "factor type" ;
    rdfs:domain uofa:CredibilityFactor ;
    rdfs:range xsd:string ;
    rdfs:comment "Which credibility dimension this factor covers, named from the taxonomy the assessment follows." .

uofa:factorStandard a rdf:Property ;
    rdfs:label "factor standard" ;
    rdfs:domain uofa:CredibilityFactor ;
    rdfs:range xsd:string ;
    rdfs:comment "Names the standard whose factor taxonomy this assessment follows. Recording it as data is what lets one vocabulary serve several standards." .

uofa:factorStatus a rdf:Property ;
    rdfs:label "factor status" ;
    rdfs:domain uofa:CredibilityFactor ;
    rdfs:comment "Whether this factor was assessed, and if not, why not. A factor left silent and a factor deliberately scoped out are different claims." .

uofa:requiredLevel a rdf:Property ;
    rdfs:label "required level" ;
    rdfs:domain uofa:CredibilityFactor ;
    rdfs:range xsd:integer ;
    rdfs:comment "The rigor this factor has to reach for the assessment to stand, set before the evidence is gathered. The standard that fixes the scale is recorded separately on the factor." .

uofa:achievedLevel a rdf:Property ;
    rdfs:label "achieved level" ;
    rdfs:domain uofa:CredibilityFactor ;
    rdfs:range xsd:integer ;
    rdfs:comment "The rigor this factor actually reached once the evidence was in, read against the required level to show any shortfall." .

uofa:acceptanceCriteria a rdf:Property ;
    rdfs:label "acceptance criteria" ;
    rdfs:range uofa:AcceptanceCriteria ;
    rdfs:comment "The bar a factor or claim had to clear, stated before the evidence was weighed against it. Distinct from the AcceptanceCriteria class, which is a standalone node naming the whole rubric." .

uofa:criteriaSet a rdf:Property ;
    rdfs:label "criteria set" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:comment "The rubric this assessment was graded against, whether a published standard or one the organization set itself." .


# §A.6 — validation and verification.

uofa:comparedAgainst a rdf:Property ;
    rdfs:label "compared against" ;
    rdfs:domain uofa:ValidationResult ;
    rdfs:range uofa:Comparator ;
    rdfs:comment "Links a validation result to the comparator it was measured against. Its absence is what makes a stated comparison uncheckable." .

uofa:sourceReference a rdf:Property ;
    rdfs:label "source reference" ;
    rdfs:comment "Points at where an input actually came from, so its pedigree can be traced rather than asserted. The provenance records that carry it are defined by packs rather than by core, so no domain is declared here." .

uofa:hasUncertaintyQuantification a rdf:Property ;
    rdfs:label "has uncertainty quantification" ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Whether an uncertainty quantification is documented. Carried by the package or by a single validation result, so no single domain is declared. The flag records presence, not quality." .

uofa:hasSensitivityAnalysis a rdf:Property ;
    rdfs:label "has sensitivity analysis" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Whether the package documents a sensitivity analysis. The flag records presence, not quality." .

uofa:currentModelVersion a rdf:Property ;
    rdfs:label "current model version" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:comment "The model version this assessment describes, so evidence gathered against an older build is visible as such." .


# §A.7 — weakeners.

uofa:patternId a rdf:Property ;
    rdfs:label "pattern id" ;
    rdfs:comment "Identifies which catalogued weakener pattern fired, so the same gap carries the same name across packages." .

uofa:severity a rdf:Property ;
    rdfs:label "severity" ;
    rdfs:comment "How far a weakener undermines the claim it was raised against. Set by the pattern rather than by the author of the record." .

uofa:affectedNode a rdf:Property ;
    rdfs:label "affected node" ;
    rdfs:comment "The node a weakener was raised against, so a reader can go to the evidence rather than the summary." .


# §A.8 — the decision.

uofa:decision a rdf:Property ;
    rdfs:label "decision" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:comment "The package-level verdict, carried alongside the fuller decision record rather than replacing it." .

uofa:outcome a rdf:Property ;
    rdfs:label "outcome" ;
    rdfs:comment "The result reached, kept separate from the reasoning that produced it. Carried by a decision record or by a validation result, so no single domain is declared." .

uofa:rationale a rdf:Property ;
    rdfs:label "rationale" ;
    rdfs:comment "The reasoning behind a judgement, written out so a reader can weigh it rather than take the outcome on trust. Carried by a decision record or by a credibility factor, so no single domain is declared." .

uofa:actor a rdf:Property ;
    rdfs:label "actor" ;
    rdfs:domain uofa:DecisionRecord ;
    rdfs:comment "Who made the decision, identified rather than described, so the record names a responsible party." .

uofa:role a rdf:Property ;
    rdfs:label "role" ;
    rdfs:domain uofa:DecisionRecord ;
    rdfs:comment "The capacity in which the actor decided, so a reader knows whose judgement this was." .

uofa:decidedAt a rdf:Property ;
    rdfs:label "decided at" ;
    rdfs:domain uofa:DecisionRecord ;
    rdfs:comment "When the judgement was reached, which fixes what evidence could have informed it." .

uofa:hasOffsetRationale a rdf:Property ;
    rdfs:label "has offset rationale" ;
    rdfs:domain uofa:DecisionRecord ;
    rdfs:range uofa:OffsetRationale ;
    rdfs:comment "Links a decision record to a stated reason for accepting a factor that fell short." .

uofa:refersToFactor a rdf:Property ;
    rdfs:label "refers to factor" ;
    rdfs:domain uofa:OffsetRationale ;
    rdfs:range uofa:CredibilityFactor ;
    rdfs:comment "Links an offset rationale to the specific factor it is offered for." .

uofa:justification a rdf:Property ;
    rdfs:label "justification" ;
    rdfs:domain uofa:OffsetRationale ;
    rdfs:comment "The argument for accepting a shortfall, written out so a reader can judge whether it holds." .


# §A.9 — quality metrics.

uofa:credibilityIndex a rdf:Property ;
    rdfs:label "credibility index" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:comment "A single summary figure for the package, useful for sorting records and no substitute for reading one." .

uofa:traceCompleteness a rdf:Property ;
    rdfs:label "trace completeness" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:comment "How much of the evidence chain is actually linked up, as a proportion." .

uofa:verificationCoverage a rdf:Property ;
    rdfs:label "verification coverage" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:comment "How much of what needed verifying was actually verified, as a proportion." .

uofa:validationCoverage a rdf:Property ;
    rdfs:label "validation coverage" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:comment "How much of what needed validating was actually validated, as a proportion." .

uofa:uncertaintyCIWidth a rdf:Property ;
    rdfs:label "uncertainty interval width" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:comment "The width of the reported confidence interval, giving a reader the spread behind a headline number." .


# §A.10 — integrity and provenance.

uofa:hash a rdf:Property ;
    rdfs:label "hash" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:comment "A digest over the canonical form of the package, letting a reader detect any change since it was signed." .

uofa:signature a rdf:Property ;
    rdfs:label "signature" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:comment "A cryptographic signature over the package hash, binding the record to whoever signed it." .

uofa:signatureAlg a rdf:Property ;
    rdfs:label "signature algorithm" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:comment "Which scheme produced the signature, so a verifier knows how to check it." .

uofa:canonicalizationAlg a rdf:Property ;
    rdfs:label "canonicalization algorithm" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:comment "Which canonical form the hash was computed over, without which the hash cannot be reproduced." .

uofa:toolVersion a rdf:Property ;
    rdfs:label "tool version" ;
    rdfs:comment "Which version of the tooling produced the record, so the same inputs can be replayed." .

uofa:tool a rdf:Property ;
    rdfs:label "tool" ;
    rdfs:comment "Which tool produced the record or the evidence it carries." .

uofa:commit a rdf:Property ;
    rdfs:label "commit" ;
    rdfs:comment "The source revision the tooling was at, tying a run to exact code rather than a version number." .

uofa:version a rdf:Property ;
    rdfs:label "version" ;
    rdfs:comment "A version string for whatever it is attached to. Used where no more specific version property applies." .


# §A.11 — entities the package binds.

uofa:Model a rdfs:Class ;
    rdfs:label "Model" ;
    rdfs:comment "The computational model whose credibility the package assesses." .

uofa:Dataset a rdfs:Class ;
    rdfs:label "Dataset" ;
    rdfs:comment "A body of data the model was run against or compared with." .

uofa:Requirement a rdfs:Class ;
    rdfs:label "Requirement" ;
    rdfs:comment "The engineering requirement the model is being trusted to help satisfy." .

uofa:ModelConfiguration a rdfs:Class ;
    rdfs:label "Model Configuration" ;
    rdfs:comment "A particular setup of the model that produced some evidence, carrying the model version it exercised." .

uofa:modelVersion a rdf:Property ;
    rdfs:label "model version" ;
    rdfs:domain uofa:ModelConfiguration ;
    rdfs:comment "Which model revision a configuration exercised, read against the version the package claims to describe so drift shows up." .

uofa:modelRevisionDate a rdf:Property ;
    rdfs:label "model revision date" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "When the current model revision was made, so evidence older than the model it describes can be spotted." .

uofa:supports a rdf:Property ;
    rdfs:label "supports" ;
    rdfs:comment "Links evidence to the claim it is offered in support of." .


# §A.12 — where a claim stops holding.

uofa:ApplicabilityConstraint a rdfs:Class ;
    rdfs:label "Applicability Constraint" ;
    rdfs:comment "A stated limit on where a claim holds. With an operating envelope it is what gives a context of use a boundary." .

uofa:OperatingEnvelope a rdfs:Class ;
    rdfs:label "Operating Envelope" ;
    rdfs:comment "The input range a model is claimed to hold over, given as bounds rather than prose." .

uofa:hasApplicabilityConstraint a rdf:Property ;
    rdfs:label "has applicability constraint" ;
    rdfs:comment "Links a context of use to a stated limit on where its claim holds." .


# §A.13 — verification, review and sensitivity.

uofa:SensitivityAnalysis a rdfs:Class ;
    rdfs:label "Sensitivity Analysis" ;
    rdfs:comment "Work done to find which inputs the model answer actually depends on." .

uofa:hasVerificationActivity a rdf:Property ;
    rdfs:label "has verification activity" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:comment "Links a record to work done to check the model was built and solved correctly." .

uofa:activityType a rdf:Property ;
    rdfs:label "activity type" ;
    rdfs:comment "What kind of work an activity was, read against the verification method the requirement asked for." .

uofa:requiredVerificationMethod a rdf:Property ;
    rdfs:label "required verification method" ;
    rdfs:comment "The method a requirement asks for, read against what the generating activity actually did." .

uofa:assessmentPhase a rdf:Property ;
    rdfs:label "assessment phase" ;
    rdfs:comment "Whether a factor was judged on the capability available or on the results actually obtained." .

uofa:ReviewActivity a rdfs:Class ;
    rdfs:label "Review Activity" ;
    rdfs:comment "A review carried out on the model or its evidence, recording who reviewed and of what kind." .

uofa:reviewer a rdf:Property ;
    rdfs:label "reviewer" ;
    rdfs:domain uofa:ReviewActivity ;
    rdfs:comment "Who carried out a review, named so the review has an accountable author." .

uofa:reviewType a rdf:Property ;
    rdfs:label "review type" ;
    rdfs:domain uofa:ReviewActivity ;
    rdfs:comment "What kind of review was carried out, such as internal or independent." .


# §A.14 — process, deployment and input pedigree.

uofa:ProcessAttestation a rdfs:Class ;
    rdfs:label "Process Attestation" ;
    rdfs:comment "A statement that a defined process was followed, naming who stands behind it." .

uofa:processType a rdf:Property ;
    rdfs:label "process type" ;
    rdfs:domain uofa:ProcessAttestation ;
    rdfs:comment "Which process an attestation covers." .

uofa:attestedBy a rdf:Property ;
    rdfs:label "attested by" ;
    rdfs:domain uofa:ProcessAttestation ;
    rdfs:comment "Who stands behind a process attestation." .

uofa:DeploymentRecord a rdfs:Class ;
    rdfs:label "Deployment Record" ;
    rdfs:comment "A record of the model being put into use somewhere, and how that went." .

uofa:deployedIn a rdf:Property ;
    rdfs:label "deployed in" ;
    rdfs:domain uofa:DeploymentRecord ;
    rdfs:comment "Where the model was put into use." .

uofa:deploymentOutcome a rdf:Property ;
    rdfs:label "deployment outcome" ;
    rdfs:domain uofa:DeploymentRecord ;
    rdfs:comment "How a deployment turned out, recorded so a later assessment can learn from it." .

uofa:InputPedigreeLink a rdfs:Class ;
    rdfs:label "Input Pedigree Link" ;
    rdfs:comment "Traces an input back to where it came from, with a rating of how well established that source is." .

uofa:pedigreeLevel a rdf:Property ;
    rdfs:label "pedigree level" ;
    rdfs:domain uofa:InputPedigreeLink ;
    rdfs:range xsd:integer ;
    rdfs:comment "How well established an input source is, on a fixed scale recorded alongside the link back to it." .

uofa:dataVintage a rdf:Property ;
    rdfs:label "data vintage" ;
    rdfs:domain uofa:Dataset ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "When the data was produced, so a reader can tell how current the evidence behind a claim is." .

uofa:documentReference a rdf:Property ;
    rdfs:label "document reference" ;
    rdfs:comment "Points at the document a statement refers to, so the reference can be followed. The records that carry it are defined by packs rather than by core, so no domain is declared here." .

uofa:referencesIdentifier a rdf:Property ;
    rdfs:label "references identifier" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:comment "Points at an identifier defined elsewhere. One that resolves nowhere is what makes a chain untraceable." .


# §A.15 — offsets and accepted shortfalls.

uofa:hasFactorOffset a rdf:Property ;
    rdfs:label "has factor offset" ;
    rdfs:comment "Links a decision to a factor shortfall it accepted, so the acceptance is visible rather than implicit." .

uofa:offsettingEvidence a rdf:Property ;
    rdfs:label "offsetting evidence" ;
    rdfs:domain uofa:OffsetRationale ;
    rdfs:comment "Evidence offered as compensating for a factor that fell short of its required level." .


# §A.16 — dispositions and discrepancies.

uofa:ProfileDisposition a rdfs:Class ;
    rdfs:label "Disposition Profile" ;
    rdfs:comment "The complete field set plus a required disposition, for records that must state what action follows the assessment." .

uofa:hasDisposition a rdf:Property ;
    rdfs:label "has disposition" ;
    rdfs:comment "Links a decision record to a typed action taken in response to it." .

uofa:actionClass a rdf:Property ;
    rdfs:label "action class" ;
    rdfs:domain uofa:Disposition ;
    rdfs:range xsd:string ;
    rdfs:comment "Which kind of action a disposition records, drawn from a fixed set so dispositions can be compared across records." .

uofa:actionParameters a rdf:Property ;
    rdfs:label "action parameters" ;
    rdfs:domain uofa:Disposition ;
    rdfs:range xsd:string ;
    rdfs:comment "Free text narrowing what a disposition applies to, where the action class alone is too coarse." .

uofa:hasDiscrepancy a rdf:Property ;
    rdfs:label "has discrepancy" ;
    rdfs:comment "Links a record to a measured gap between a surrogate prediction and the solver truth." .

uofa:surrogatePrediction a rdf:Property ;
    rdfs:label "surrogate prediction" ;
    rdfs:domain uofa:Discrepancy ;
    rdfs:range xsd:double ;
    rdfs:comment "The value the surrogate produced, compared against the solver truth to size the gap." .

uofa:solverTruth a rdf:Property ;
    rdfs:label "solver truth" ;
    rdfs:domain uofa:Discrepancy ;
    rdfs:range xsd:double ;
    rdfs:comment "The value the full solver produced, taken as the reference a surrogate is judged against." .

uofa:discrepancyMagnitude a rdf:Property ;
    rdfs:label "discrepancy magnitude" ;
    rdfs:domain uofa:Discrepancy ;
    rdfs:range xsd:double ;
    rdfs:comment "How far the surrogate prediction sits from the solver truth it was checked against." .

uofa:discrepancyRegion a rdf:Property ;
    rdfs:label "discrepancy region" ;
    rdfs:domain uofa:Discrepancy ;
    rdfs:range xsd:string ;
    rdfs:comment "Where in the input space a discrepancy was observed, so a gap can be located rather than only noted." .

uofa:measureType a rdf:Property ;
    rdfs:label "measure type" ;
    rdfs:domain uofa:Discrepancy ;
    rdfs:range xsd:string ;
    rdfs:comment "Whether a measurement describes a single point or a summary over a region." .

uofa:confidenceLevel a rdf:Property ;
    rdfs:label "confidence level" ;
    rdfs:domain uofa:Disposition ;
    rdfs:comment "How much confidence is claimed in the finding this is attached to." .


# §A.17 — timestamps the rule engine compares.

uofa:evidenceTimestamp a rdf:Property ;
    rdfs:label "evidence timestamp" ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "When an evidence artifact was produced, compared against the signing time to catch evidence dated after the record." .

uofa:signatureTimestamp a rdf:Property ;
    rdfs:label "signature timestamp" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "When the package was signed. Evidence dated after this point could not have informed it." .

uofa:isFoundationalEvidence a rdf:Property ;
    rdfs:label "is foundational evidence" ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Marks a node as the root of a provenance chain, so a chain stopping there is not read as broken." .


# §A.18 — staged vocabulary.
#
# Reserved for weakener patterns not yet shipped. The adversarial calibration
# probes target the ABSENCE of these three, and
# src/uofa_cli/adversarial/prompts/clarissa_machinery.py enforces non-emission,
# so a generator that emitted them would break the probes. They are unused on
# purpose, and the definitions say so rather than implying packages should
# carry them.

uofa:consideredAlternative a rdf:Property ;
    rdfs:label "considered alternative" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:comment "An alternative conclusion the assessment weighed and set aside. Reserved for a future weakener pattern and not yet expected in packages." .

uofa:knownLimitation a rdf:Property ;
    rdfs:label "known limitation" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:comment "A limitation the assessment acknowledges in its own evidence. Reserved for a future weakener pattern and not yet expected in packages." .

uofa:residualRiskJustification a rdf:Property ;
    rdfs:label "residual risk justification" ;
    rdfs:domain uofa:UnitOfAssurance ;
    rdfs:comment "The argument for accepting the risk left after mitigation. Reserved for a future weakener pattern and not yet expected in packages." .


# §A.19 — the v0.6 reasoning relations.
#
# Introduced by commit 1f89dc81 alongside the disposition-completion line, and
# adopted by nothing since: no package declares them, no shape constrains them,
# and every package still loads spec/context/v0.5.jsonld. Checked across the
# shipped examples, the test fixtures, the weakener corpus and the 9,000
# synthetic packages.
#
# The comments state that fact and stop there. Whether these were abandoned or
# are merely early is a claim about intent the repository cannot evidence, and
# the spec that would settle it is not public.
#
# owl:deprecated marks them without removing anything: the IRIs still resolve
# on uofa.net rather than becoming dead links.
#
# Keep owl:deprecated on its own line. site/scripts/lib/vocab-extract.mjs
# matches the subject line with a regex that requires ';' or '.' straight after
# rdf:Property, so folding this into "a rdf:Property, owl:DeprecatedProperty ;"
# would drop all five terms from the published vocabulary without erroring.

uofa:agreementMakesNonDispositive a rdf:Property ;
    rdfs:label "agreement makes non-dispositive" ;
    rdfs:comment "Declared in context v0.6 and not used by any package or shape." ;
    owl:deprecated true .

uofa:factorConstraintWarrants a rdf:Property ;
    rdfs:label "factor constraint warrants" ;
    rdfs:comment "Declared in context v0.6 and not used by any package or shape." ;
    owl:deprecated true .

uofa:frameworkTransfers a rdf:Property ;
    rdfs:label "framework transfers" ;
    rdfs:comment "Declared in context v0.6 and not used by any package or shape." ;
    owl:deprecated true .

uofa:sustainedDefeaterJustified a rdf:Property ;
    rdfs:label "sustained defeater justified" ;
    rdfs:comment "Declared in context v0.6 and not used by any package or shape." ;
    owl:deprecated true .

uofa:thresholdDistanceModulates a rdf:Property ;
    rdfs:label "threshold distance modulates" ;
    rdfs:comment "Declared in context v0.6 and not used by any package or shape." ;
    owl:deprecated true .


################################################################
# Dispatcher: pick Minimal vs Complete constraints by profile
################################################################
uofa:UnitOfAssurance_ProfileShape
  a sh:NodeShape ;
  sh:targetClass uofa:UnitOfAssurance ;
  # Must declare a known profile
  sh:property [
    sh:path uofa:conformsToProfile ;
    sh:in ( uofa:ProfileMinimal uofa:ProfileComplete uofa:ProfileDisposition ) ;
    sh:minCount 1 ;
    sh:message "conformsToProfile must be ProfileMinimal, ProfileComplete, or ProfileDisposition." ;
  ] ;
  # EITHER MinimalBody when profile = Minimal OR CompleteBody when profile = Complete
  sh:or (
    [
      sh:property [
        sh:path uofa:conformsToProfile ;
        sh:hasValue uofa:ProfileMinimal
      ] ;
      sh:node uofa:UnitOfAssurance_MinimalBody
    ]
    [
      sh:property [
        sh:path uofa:conformsToProfile ;
        sh:hasValue uofa:ProfileComplete
      ] ;
      sh:node uofa:UnitOfAssurance_CompleteBody
    ]
    # v0.6 additive: ProfileDisposition dispatches to the Disposition body.
    [
      sh:property [
        sh:path uofa:conformsToProfile ;
        sh:hasValue uofa:ProfileDisposition
      ] ;
      sh:node uofa:UnitOfAssurance_DispositionBody
    ]
  ) .

################################################################
# Disposition body (v0.6, additive). ProfileDisposition = the full
# Complete body PLUS a required hasDisposition edge: it reuses
# CompleteBody via sh:node so the profile only ADDS, never relaxes.
# Defined in core (not the disposition pack) so the dispatcher branch
# above resolves a known shape during core-only validation; the
# Disposition/Discrepancy *node* shapes live in packs/disposition.
################################################################
uofa:UnitOfAssurance_DispositionBody
  a sh:NodeShape ;
  sh:node uofa:UnitOfAssurance_CompleteBody ;
  sh:property [
    sh:path uofa:hasDisposition ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:message "Disposition: must declare at least one hasDisposition (DecisionRecord → Disposition)." ;
  ] .

################################################################
# uofa:hasContextOfUse is NOT required here, and that is deliberate.
#
# Context of use is an ASME V&V 40 concept. NASA-STD-7009A defines no
# such thing -- it asks what was modelled and how well, not what
# decision the model informs. While core required it, NO 7009A document
# could produce a valid package at any profile except by inventing the
# field, and the two that did validate in the 2026-08-08 head-to-head
# validated on a context of use a model had made up.
#
# The requirement now lives in packs/vv40/shapes/vv40_shapes.ttl. Shapes
# are loaded as core + the ACTIVE packs (paths.all_shacl_schemas), which
# defaults to vv40 -- so a V&V 40 package is constrained exactly as
# before, and `--pack nasa-7009b` no longer imports a V&V 40 assumption.
#
# packs/core/pack.json calls core "Standards-agnostic". This is what
# makes that true of the UnitOfAssurance profiles.
################################################################

################################################################
# Minimal body (applies only when ProfileMinimal is chosen)
################################################################
uofa:UnitOfAssurance_MinimalBody
  a sh:NodeShape ;
  sh:property [
    sh:path uofa:bindsRequirement ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:message "Minimal: must bind at least one Requirement (IRI)." ;
  ] ;
  sh:property [
    sh:path uofa:hasValidationResult ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:message "Minimal: must include at least one ValidationResult (IRI)." ;
  ] ;
  sh:property [
    sh:path prov:generatedAtTime ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:message "Minimal: must have generation timestamp." ;
  ] ;
  sh:property [
    sh:path uofa:hash ;
    sh:minCount 1 ;
    sh:pattern "^(sha256|sha384|sha512):[a-f0-9]{64,128}$" ;
    sh:message "Minimal: must include a content hash in algorithm:hexdigest format (e.g., sha256:<64 hex chars>)." ;
  ] ;
  sh:property [
    sh:path uofa:signature ;
    sh:minCount 1 ;
    sh:pattern "^(ed25519|ecdsa-p256):[a-f0-9]+$" ;
    sh:message "Minimal: must include a digital signature in algorithm:hexdigest format." ;
  ] ;
  sh:property [
    sh:path uofa:hasDecisionRecord ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:message "Minimal: must include at least one DecisionRecord (IRI)." ;
  ] .

################################################################
# Complete body (applies only when ProfileComplete is chosen)
################################################################
uofa:UnitOfAssurance_CompleteBody
  a sh:NodeShape ;
  sh:property [
    sh:path uofa:bindsRequirement ; sh:nodeKind sh:IRI ; sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path uofa:hasContextOfUse ; sh:nodeKind sh:IRI ; sh:minCount 1 ;
    sh:message "Complete: must declare a Context of Use (V&V 40 COU)." ;
  ] ;
  sh:property [
    sh:path uofa:bindsModel ; sh:nodeKind sh:IRI ; sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path uofa:bindsDataset ; sh:nodeKind sh:IRI ; sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path uofa:hasValidationResult ; sh:nodeKind sh:IRI ; sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path prov:wasDerivedFrom ; sh:nodeKind sh:IRI ; sh:minCount 1 ;
    sh:message "Complete: link to prior artifact (e.g., parent UoA/run logs)." ;
  ] ;
  sh:property [
    sh:path prov:wasAttributedTo ; sh:nodeKind sh:IRI ; sh:minCount 1 ;
    sh:message "Complete: identify responsible actor or organization." ;
  ] ;
  sh:property [
    sh:path prov:generatedAtTime ; sh:datatype xsd:dateTime ; sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path uofa:hash ;
    sh:minCount 1 ;
    sh:pattern "^(sha256|sha384|sha512):[a-f0-9]{64,128}$" ;
    sh:message "Complete: hash must be algorithm:hexdigest format (e.g., sha256:<64 hex chars>)." ;
  ] ;
  sh:property [
    sh:path uofa:signature ;
    sh:minCount 1 ;
    sh:pattern "^(ed25519|ecdsa-p256):[a-f0-9]+$" ;
    sh:message "Complete: signature must be algorithm:hexdigest format." ;
  ] ;

  # ---- v0.3 additions: COU metadata ----

  sh:property [
    sh:path uofa:modelRiskLevel ;
    sh:datatype xsd:integer ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:minInclusive 1 ;
    sh:maxInclusive 5 ;
    sh:message "Complete: modelRiskLevel is required (integer 1–5, per V&V 40 risk matrix)." ;
  ] ;
  # deviceClass carries no enum in core, deliberately.
  #
  # The FDA classification is a property of the *regulatory regime* the COU sits
  # in, not of every package. Constraining it here applied Class I/II/III to
  # aerospace and thermal packages, and the effect was the opposite of what a
  # constraint is for: of 50 corpus packages, the 18 that passed included 14
  # turbomachinery models labelled "Class II" -- a fabricated medical device
  # class for a CFD simulation -- while packages that honestly wrote
  # "Turbomachinery (Centrifugal Pump)" failed. The shape was rewarding
  # invention and punishing accuracy.
  #
  # The enum lives in packs/vv40/shapes/vv40_shapes.ttl, where V&V 40's
  # medical-device scope actually applies. Domains with their own regime
  # constrain it in their own pack; domains with none leave it unconstrained.
  sh:property [
    sh:path uofa:deviceClass ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "Complete: deviceClass must be a single string, if present." ;
  ] ;
  sh:property [
    sh:path uofa:couName ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:message "Complete: couName is a human-readable COU label for diff output." ;
  ] ;
  sh:property [
    sh:path uofa:decision ;
    sh:maxCount 1 ;
    sh:in ( "Accepted" "Not accepted" ) ;
    sh:message "Complete: decision must be 'Accepted' or 'Not accepted'." ;
  ] ;
  sh:property [
    sh:path uofa:hasUncertaintyQuantification ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:message "Complete: hasUncertaintyQuantification must be a boolean." ;
  ] ;

  # ---- Credibility metrics (unchanged from v0.2) ----

  sh:property [
    sh:path uofa:credibilityIndex ;
    sh:or (
      [ sh:datatype xsd:decimal ]
      [ sh:datatype xsd:double ]
    ) ;
    sh:minInclusive "0.0"^^xsd:decimal ;
    sh:maxInclusive "1.0"^^xsd:decimal ;
  ] ;

  # Trace completeness
  sh:property [
    sh:path uofa:traceCompleteness ;
    sh:or (
      [ sh:datatype xsd:decimal ]
      [ sh:datatype xsd:double ]
    ) ;
    sh:minInclusive "0.0"^^xsd:decimal ;
    sh:maxInclusive "1.0"^^xsd:decimal ;
  ] ;

  # Verification coverage
  sh:property [
    sh:path uofa:verificationCoverage ;
    sh:or (
      [ sh:datatype xsd:decimal ]
      [ sh:datatype xsd:double ]
    ) ;
    sh:minInclusive "0.0"^^xsd:decimal ;
    sh:maxInclusive "1.0"^^xsd:decimal ;
  ] ;

  # Validation coverage
  sh:property [
    sh:path uofa:validationCoverage ;
    sh:or (
      [ sh:datatype xsd:decimal ]
      [ sh:datatype xsd:double ]
    ) ;
    sh:minInclusive "0.0"^^xsd:decimal ;
    sh:maxInclusive "1.0"^^xsd:decimal ;
  ] ;

  # Uncertainty CI width (only lower bound needed)
  sh:property [
    sh:path uofa:uncertaintyCIWidth ;
    sh:or (
      [ sh:datatype xsd:decimal ]
      [ sh:datatype xsd:double ]
    ) ;
    sh:minInclusive "0.0"^^xsd:decimal ;
  ] ;

  sh:property [
    sh:path uofa:hasCredibilityFactor ;
    sh:node uofa:CredibilityFactorShape ;
    sh:minCount 1 ;
    sh:message "Complete: must include at least one CredibilityFactor (V&V 40 Table 5-1)." ;
  ] ;
  sh:property [
    sh:path uofa:hasWeakener ;
    sh:node uofa:WeakenerAnnotationShape ;
    # No sh:minCount — zero weakeners is a valid (clean) UofA
  ] ;

  sh:property [
    sh:path uofa:assuranceLevel ; sh:in ( "Low" "Medium" "High" ) ;
  ] ;
  sh:property [
    sh:path uofa:criteriaSet ; sh:nodeKind sh:IRI ;
    sh:message "Complete: reference criteria set used (e.g., VVUQ-90, NASA-7009)." ;
  ] ;
  sh:property [
    sh:path uofa:hasDecisionRecord ; sh:nodeKind sh:IRI ; sh:minCount 1 ;
  ] .

################################################################
# CredibilityFactor node shape (standards-agnostic)
#
# v0.4 changes:
#   - factorType enum REMOVED from core — now defined by domain
#     packs (vv40, nasa-7009b). Core only requires factorType to
#     be a non-empty string.
#   - factorStandard added (optional): identifies which standard
#     defines this factor (e.g., "ASME-VV40-2018", "NASA-STD-7009B").
#   - assessmentPhase added (optional): "capability" or "results"
#     (used by NASA-STD-7009B, not V&V 40).
#   - hasEvidence added (optional): IRI link to backing evidence.
#   - Level range remains 0–5 in core; packs may constrain further.
################################################################
uofa:CredibilityFactorShape
  a sh:NodeShape ;
  sh:property [
    sh:path uofa:factorType ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "CredibilityFactor must have a factorType string." ;
  ] ;
  sh:property [
    sh:path uofa:factorStatus ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( "assessed" "not-assessed" "scoped-out" "not-applicable" ) ;
    sh:message "Every credibility factor must declare its assessment status." ;
  ] ;
  sh:property [
    sh:path uofa:factorStandard ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path uofa:assessmentPhase ;
    sh:in ( "capability" "results" ) ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path uofa:requiredLevel ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minInclusive 0 ;
    sh:maxInclusive 5 ;
    sh:message "requiredLevel must be an integer 0–5 (0 = not set)." ;
  ] ;
  sh:property [
    sh:path uofa:achievedLevel ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minInclusive 0 ;
    sh:maxInclusive 5 ;
    sh:message "achievedLevel must be an integer 0–5 (0 = not set)." ;
  ] .

################################################################
# WeakenerAnnotation node shape (C3 quality gate)
################################################################
uofa:WeakenerAnnotationShape
  a sh:NodeShape ;
  sh:property [
    sh:path uofa:patternId ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:pattern "^(W-[A-Z]+-(\\d{2,}|[A-Z][A-Z0-9-]*)|COMPOUND-([A-Z][A-Z0-9]*-)?\\d{2})$" ;
    sh:message "patternId must match catalog format W-<FAMILY>-<NN or WORD-ID>, COMPOUND-NN, or COMPOUND-<FAMILY>-NN (e.g., W-EP-01, W-CON-03, W-PROV-01, W-NASA-02, W-SURR-03, W-AIMS-AUDIT-STALE, COMPOUND-01, COMPOUND-EV-01). Open to any pack-declared family — the C2 shape must accept every patternId the active packs emit (C2↔C3 consistency)." ;
  ] ;
  sh:property [
    sh:path uofa:severity ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( "Critical" "High" "Medium" "Low" ) ;
    sh:message "severity must be Critical, High, Medium, or Low." ;
  ] ;
  sh:property [
    sh:path uofa:affectedNode ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:message "affectedNode must be an IRI pointing to the flagged graph node." ;
  ] ;
  sh:property [
    sh:path schema:description ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:message "description should explain why this weakener fires." ;
  ] .

################################################################
# Evidence class shapes (v0.4 — used by NASA-STD-7009B pack)
################################################################

uofa:ReviewActivityShape a sh:NodeShape ;
    sh:targetClass uofa:ReviewActivity ;
    sh:property [
        sh:path uofa:reviewer ;
        sh:minCount 1 ;
        sh:message "ReviewActivity must identify a reviewer." ;
    ] ;
    sh:property [
        sh:path uofa:reviewType ;
        sh:in ( "independent" "internal" "peer" ) ;
    ] .

uofa:ProcessAttestationShape a sh:NodeShape ;
    sh:targetClass uofa:ProcessAttestation ;
    sh:property [
        sh:path uofa:processType ;
        sh:minCount 1 ;
        sh:in ( "configuration-management" "sqa" "change-control" "documentation" ) ;
    ] ;
    sh:property [
        sh:path uofa:attestedBy ;
        sh:minCount 1 ;
    ] .

uofa:DeploymentRecordShape a sh:NodeShape ;
    sh:targetClass uofa:DeploymentRecord ;
    sh:property [
        sh:path uofa:deployedIn ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path uofa:deploymentOutcome ;
        sh:in ( "successful" "partial" "unsuccessful" ) ;
    ] .

uofa:InputPedigreeLinkShape a sh:NodeShape ;
    sh:targetClass uofa:InputPedigreeLink ;
    sh:property [
        sh:path uofa:sourceReference ;
        sh:minCount 1 ;
        sh:message "InputPedigreeLink must reference the original data source." ;
    ] ;
    sh:property [
        sh:path uofa:pedigreeLevel ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 4 ;
    ] .

################################################################
# ---- v0.5 additions: weakener catalog expansion ----
#
# All properties below are optional. They back the new v0.5 rule
# catalog (W-EP-03, W-AL-02, W-ON-02, W-AR-03, W-AR-04, W-CON-01..05,
# W-PROV-01) and staged support for v0.6 W-AR-06/W-AR-07.
################################################################

uofa:Dataset_v05Shape a sh:NodeShape ;
    sh:targetClass uofa:Dataset ;
    sh:property [
        sh:path uofa:dataVintage ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:message "dataVintage is the ISO-8601 timestamp of the dataset's vintage." ;
    ] .

uofa:ModelConfiguration_v05Shape a sh:NodeShape ;
    sh:targetClass uofa:ModelConfiguration ;
    sh:property [
        sh:path uofa:modelVersion ;
        sh:maxCount 1 ;
        sh:message "modelVersion identifies the model revision exercised by this configuration." ;
    ] .

uofa:SensitivityAnalysisShape a sh:NodeShape ;
    sh:targetClass uofa:SensitivityAnalysis ;
    sh:property [
        sh:path dct:identifier ;
        sh:maxCount 1 ;
    ] .

uofa:UnitOfAssurance_v05Shape a sh:NodeShape ;
    sh:targetClass uofa:UnitOfAssurance ;
    sh:property [
        sh:path uofa:modelRevisionDate ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:message "modelRevisionDate is the timestamp of the current model revision (for W-EP-03 staleness comparison)." ;
    ] ;
    sh:property [
        sh:path uofa:signatureTimestamp ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:message "signatureTimestamp is the UofA signing timestamp (for W-CON-03 future-date comparison)." ;
    ] ;
    sh:property [
        sh:path uofa:hasSensitivityAnalysis ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "hasSensitivityAnalysis is a boolean indicating whether a documented sensitivity analysis is part of the assurance package (mirrors hasUncertaintyQuantification). For W-AL-02." ;
    ] ;
    sh:property [
        sh:path uofa:hasVerificationActivity ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path uofa:referencesIdentifier ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path uofa:residualRiskJustification ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path uofa:consideredAlternative ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path uofa:knownLimitation ;
        sh:nodeKind sh:IRI ;
    ] .

# Evidence-level properties: isFoundationalEvidence and evidenceTimestamp
# may appear on any Evidence subclass, so target them broadly rather than
# pinning a single class shape.
uofa:EvidenceMarkers_v05Shape a sh:NodeShape ;
    sh:targetSubjectsOf uofa:isFoundationalEvidence ;
    sh:property [
        sh:path uofa:isFoundationalEvidence ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "isFoundationalEvidence = true marks a provenance-chain root (for W-PROV-01)." ;
    ] .

uofa:EvidenceTimestamp_v05Shape a sh:NodeShape ;
    sh:targetSubjectsOf uofa:evidenceTimestamp ;
    sh:property [
        sh:path uofa:evidenceTimestamp ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:message "evidenceTimestamp is when an evidence artifact was produced (for W-CON-03)." ;
    ] .

# OffsetRationale node shape (Phase 2.5 v0.5.11). DecisionRecords MAY
# carry one or more `hasOffsetRationale` children when an Accepted
# decision is made despite a credibility-factor shortfall — the rationale
# names the affected factor and records the offsetting evidence (e.g.,
# "N=11 sample size offsets single-test-condition shortfall per ASTM
# spinal-device convention"). The W-AR-02 rule reads this to suppress
# its `noValue` check, allowing legitimate V&V 40 Accepted-with-offset
# findings (per Nagaraja et al., 2024 §4) to pass without firing.
uofa:OffsetRationaleShape a sh:NodeShape ;
    sh:targetClass uofa:OffsetRationale ;
    sh:property [
        sh:path uofa:refersToFactor ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "OffsetRationale must refer to the CredibilityFactor it offsets." ;
    ] ;
    sh:property [
        sh:path uofa:justification ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "OffsetRationale must include a justification text." ;
    ] ;
    sh:property [
        sh:path uofa:offsettingEvidence ;
        sh:nodeKind sh:IRI ;
    ] .

# DecisionRecord-level: hasOffsetRationale references one or more
# OffsetRationale nodes. Optional — only present when the Accepted
# decision is made despite a documented factor-level shortfall.
uofa:DecisionRecordOffsetShape a sh:NodeShape ;
    sh:targetSubjectsOf uofa:hasOffsetRationale ;
    sh:property [
        sh:path uofa:hasOffsetRationale ;
        sh:nodeKind sh:IRI ;
        sh:class uofa:OffsetRationale ;
        sh:message "hasOffsetRationale must reference an OffsetRationale node (for W-AR-02 predicate)." ;
    ] .
