@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix uofa: <https://uofa.net/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# MRM-NIST factor taxonomy — NIST AI RMF documentation factors for the model-card
# unit (17 factors, grouped by the four RMF functions). This is a *presence-only*
# completeness profile: it validates the factor-name enum only. There is NO
# requiredLevel/achievedLevel range shape — the pack has no 1-5 levels and no risk
# tiers (a documentation category is present, absent, or out-of-scope-at-card).
#
# Scope guard: the shape only constrains factors tagged factorStandard
# "NIST-AI-RMF-1.0" (the stamp excel_mapper._map_factor applies). vv40/nasa
# factors carry a different standard, so this shape stays silent on them, and
# their name shapes (guarded on their own standard) stay silent on these. A
# factor with no factorStandard at all is not matched here (the triple is
# required, not OPTIONAL), leaving the core/legacy path to the vv40 !BOUND clause.
uofa:MrmNistCredibilityFactorShape a sh:NodeShape ;
    sh:targetClass uofa:CredibilityFactor ;
    sh:sparql [
        sh:message "factorType must be one of the 17 MRM-NIST (NIST AI RMF) documentation factor names." ;
        sh:select """
            SELECT $this
            WHERE {
                $this uofa:factorType ?ft .
                $this uofa:factorStandard ?fs .
                FILTER (
                    ?fs = "NIST-AI-RMF-1.0"
                    && ?ft NOT IN (
                        "Ownership and accountability",
                        "Intended use",
                        "License and usage terms",
                        "Out-of-scope use",
                        "Task and domain context",
                        "Deployment setting",
                        "Known limitations",
                        "Affected populations",
                        "Evaluation metrics",
                        "Evaluation methodology",
                        "Bias and fairness analysis",
                        "Robustness and safety testing",
                        "Test and evaluation data",
                        "Mitigations and safeguards",
                        "Residual risk",
                        "Monitoring and feedback",
                        "Versioning and update policy"
                    )
                )
            }
        """ ;
    ] .

# ── Group B: NIST AI 800-3 evaluation-sufficiency factors ────────────────────
# The second factor group in this pack. Group A (above) asks whether the model
# documents itself; Group B asks whether the reported numbers in that
# documentation are credible as validation evidence.
#
# Firewall: this shape uses the same *required* factorStandard triple as Group A,
# not vv40's OPTIONAL + !BOUND fallback. That is what keeps the two groups
# mutually silent inside one pack -- a Group-A factor carries
# "NIST-AI-RMF-1.0" and never matches here; a Group-B factor carries
# "NIST-AI-800-3" and never matches the Group-A shape. vv40's !BOUND clause is
# also unreachable for both, since each carries a bound standard that is not
# ASME-VV40-2018. Do not relax either guard to OPTIONAL: the moment one group's
# shape can see the other's factors, every Group-B factor becomes a Group-A
# name violation and the pack reports 22 failures on a valid package.
#
# Presence-only, exactly like Group A. There is deliberately no
# requiredLevel/achievedLevel range shape -- Group B has no 1-5 levels (pack
# spec: "presence/absence like model-credibility; levels are a later opt-in variant if
# ever"). Keep this list in sync with AI_800_3_FACTOR_NAMES in
# src/uofa_cli/excel_constants.py by hand; tests/test_excel_constants_derived.py
# guards the pairing.
uofa:AI8003CredibilityFactorShape a sh:NodeShape ;
    sh:targetClass uofa:CredibilityFactor ;
    sh:sparql [
        sh:message "factorType must be one of the 6 NIST AI 800-3 evaluation-sufficiency factor names." ;
        sh:select """
            SELECT $this
            WHERE {
                $this uofa:factorType ?ft .
                $this uofa:factorStandard ?fs .
                FILTER (
                    ?fs = "NIST-AI-800-3"
                    && ?ft NOT IN (
                        "Score and uncertainty",
                        "Item sampling",
                        "Harness determinism",
                        "Null calibration",
                        "Context-of-use relevance",
                        "Construct validity"
                    )
                )
            }
        """ ;
    ] .
