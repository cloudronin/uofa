# syntax=docker/dockerfile:1
#
# UofA Gap-Finder — prebuilt BASE image for the HuggingFace Docker Space.
#
# Carries the heavy, slow-changing layers: the Jena rule-engine JAR, the uofa
# wheel (open core + vv40 + nasa-7009b, with packs/spec/specs force-included),
# and JRE 17 for C3 weakeners. Built ONCE by CI
# (.github/workflows/deploy-space.yml, `base` job) and pushed to GHCR. The
# Space's thin Dockerfile then does only `FROM this + COPY space/`.
#
# Build from the REPO ROOT (needs src/, packs/, spec/, specs/, build-config/):
#     docker build -f space/Dockerfile.base \
#       -t ghcr.io/cloudronin/uofa-demo-base:latest .
#
# INFERENCE lives at a hosted provider, configured by the UOFA_SPACE_LLM_* vars
# below and reachable only with the API key supplied as a Space SECRET. The
# image previously carried a pinned Ollama runtime and a baked ~3 GB qwen3.5:4b,
# which is why so much of this file used to be about layer ordering: the model
# sat above the wheel so a src/ change would not re-pull 3 GB. That constraint is
# gone with the model, but the reason it existed is worth keeping in view --
# baking 3 GB on HF's own builder is what tipped cold builds past the 30-minute
# limit ("Build error: Job timeout"). Do not reintroduce a large bake here
# without restoring that ordering discipline.
#
# The local path still works and is still supported: `space/llm_env.py` falls
# back to it whenever no backend is configured, so `docker run` against a host
# Ollama, and plain `python -m space.app` on a laptop, behave as they always did.
# What changed is only what THIS image ships.

# ── Stage 1: build the Jena rule-engine JAR ──────────────────────────────────
FROM maven:3-eclipse-temurin-17 AS jar
WORKDIR /build
COPY src/weakener-engine/ ./src/weakener-engine/
RUN cd src/weakener-engine && mvn -q -DskipTests package

# ── Stage 2: build the wheel with the JAR + packs/spec force-included ─────────
FROM python:3.11-slim-bookworm AS wheel
WORKDIR /build
COPY . .
COPY --from=jar /build/src/weakener-engine/target/uofa-weakener-engine-0.1.0.jar \
     src/weakener-engine/target/uofa-weakener-engine-0.1.0.jar
RUN pip install --no-cache-dir hatchling \
 && UOFA_BUNDLE_JAR=1 pip wheel --no-deps -w /wheels .

# ── Stage 3: runtime base ────────────────────────────────────────────────────
FROM python:3.11-slim-bookworm

# The UOFA_SPACE_LLM_* values are configuration, not secrets, so they live here
# in git where the model choice is reviewable and testable
# (tests/space/test_docker_assets.py asserts them). The API KEY named by
# UOFA_SPACE_LLM_KEY_ENV is supplied only as a HuggingFace Space secret and must
# never appear in this file, in space/, or anywhere else in the repo:
# space/deploy_to_hf.py refuses to upload .key/.pem/.env at all.
ENV PYTHONUNBUFFERED=1 \
    HOME=/home/user \
    UOFA_SPACE_LLM_BACKEND=openai-compatible \
    UOFA_SPACE_LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo \
    UOFA_SPACE_LLM_BASE_URL=https://api.together.xyz/v1 \
    UOFA_SPACE_LLM_KEY_ENV=TOGETHER_API_KEY \
    GRADIO_SERVER_NAME=0.0.0.0 \
    GRADIO_SERVER_PORT=7860

# JRE 17 for the rule engine (C3). Removing it does NOT fail loudly: the
# weakener stage degrades to [] when Java is absent, so every run would silently
# become a completeness-only readout with no error anywhere. ca-certificates is
# now load-bearing too, since inference is an outbound HTTPS call.
RUN apt-get update && apt-get install -y --no-install-recommends \
        openjdk-17-jre-headless ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# HF Spaces run as a non-root user (UID 1000).
RUN useradd -m -u 1000 user

# ── App dependencies: uofa[extract] (from the wheel) + Gradio + lead-capture ──
COPY --from=wheel /wheels/ /wheels/
COPY space/requirements.txt /tmp/space-requirements.txt
RUN pip install --no-cache-dir --retries 5 --timeout 60 "$(echo /wheels/uofa-*.whl)[extract]" \
 && pip install --no-cache-dir -r /tmp/space-requirements.txt \
 && rm -rf /wheels

# Ready-to-run base: the Space's thin Dockerfile adds only `COPY space/`.
USER user
WORKDIR /home/user/app
EXPOSE 7860
